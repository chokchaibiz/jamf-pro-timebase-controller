# Harrow TimeBase - Jamf Pro API Client credentials
# Copy to /etc/harrow-timebase/harrow-timebase.env and replace both placeholders.
# SECURITY: Keep the installed file root-owned and mode 0640 (root:harrow-timebase).
JAMF_CLIENT_ID=replace-with-jamf-api-client-id
JAMF_CLIENT_SECRET=replace-with-jamf-api-client-secret
