[Unit]
Description=Harrow TimeBase regular reconciliation outside weekday school hours

[Timer]
OnBootSec=3min
OnCalendar=Mon..Fri *-*-* 00..07,16..23:00,30:00 Asia/Bangkok
OnCalendar=Sat,Sun *-*-* *:00,30:00 Asia/Bangkok
AccuracySec=1s
RandomizedDelaySec=0
Persistent=false
Unit=harrow-timebase@reconcile-regular.service

[Install]
WantedBy=timers.target
